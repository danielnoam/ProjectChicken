    "m_SourceType": 1,
    "m_FunctionName": "GetSSAO",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": " #if defined(_SCREEN_SPACE_OCCLUSION) && !defined(_SURFACE_TYPE_TRANSPARENT) && !defined(SHADERGRAPH_PREVIEW)\r\n \n  float ssao = saturate(SampleAmbientOcclusion(ScreenPos) + (1.0 - _AmbientOcclusionParam.x));\r\n   IndirectAO = ssao;\r\n   DirectAO = lerp(1.0, ssao, _AmbientOcclusionParam.w);\r\n#else\r\n   DirectAO = 1.0;\r\n   IndirectAO = 1.0;\r\n#endif"
